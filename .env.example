# Optional: enables "AI reasoning" in the assistant. Without it, the assistant
# answers offline from the knowledge base. Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional: override the model (default: openai/gpt-oss-120b, falls back to llama-3.3-70b-versatile)
# GROQ_MODEL=openai/gpt-oss-120b

# Development only: pin extracted values for a rehearsal, e.g. when a paper marksheet's
# layout is not parsed yet. Keys are "<docType>.<field>". Ignored in production builds;
# the review page marks overridden values. Example:
# NEXT_PUBLIC_DEMO_OVERRIDES={"marksheet_12.percentage":"73%"}
